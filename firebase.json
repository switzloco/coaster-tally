{
  "apphosting": {
    "backendId": "coaster",
    "rootDir": ".",
    "alwaysDeployFromSource": true,
    "ignore": [
      "node_modules",
      ".git",
      ".next",
      "coverage",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "functions"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "database": "(default)"
  }
}
