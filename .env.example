# Copy this file to .env.local and fill in your values.
# Zero secret API keys are committed to version control.

# ── Canonical Site URL ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://coaster--coaster-tally-2026.us-central1.hosted.app

# ── Firebase Web SDK (`firebase@latest` >= 13.3.0) ───────────────────────────
# Public client web app identifiers for Coaster (`coaster-tally-2026`).
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAnvxRnS86VIkc9otvuh4Vg42g25AJnfd4
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=coaster-tally-2026.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=coaster-tally-2026
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=coaster-tally-2026.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=1:250751511013:web:046144a8ddc753664ae70c
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=250751511013
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Firebase App Check (`firebase/app-check` — #BuildHybridAI 2026) ──────────
# ReCaptcha Enterprise site key from Firebase Console -> App Check (optional in dev).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Debug token for local/judge testing (`true` auto-generates a console debug token in dev,
# or paste a registered UUID debug token from Firebase Console -> App Check -> Manage debug tokens).
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=true

# ── Chrome Built-in AI Origin Trial (`window.LanguageModel` / Gemini Nano) ───
# Origin Trial token enabling Chrome's Prompt API on production domains.
# Localhost works automatically when Chrome Prompt API flags are enabled.
NEXT_PUBLIC_CHROME_ORIGIN_TRIAL_TOKEN=

# ── Server-Side Genkit / Sunny Coaching (`/api/chat`, `/api/transcribe`) ─────
# Required for server-side Genkit agent routes, email photo parsing, and audio transcription.
# Store in GCP Secret Manager for App Hosting; set locally in .env.local.
GOOGLE_GENAI_API_KEY=
CFO_MODEL=

# ── 2-Way Gmail Companion (`+coaster@`) & Scheduled Briefings ─────────────────
GMAIL_USER=nicholas.switzer@gmail.com
GMAIL_APP_PASSWORD=
CRON_SECRET=
OUTREACH_TOKEN_SECRET=
